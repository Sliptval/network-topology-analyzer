#!/usr/bin/env python3
"""Standalone launcher for running nettop straight from a checkout.

This lets you use the tool without installing it: ``./nettop-cli scan ...``.
After ``pip install .`` the ``nettop`` command is available on your PATH and
this script is no longer needed.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from nettop.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
